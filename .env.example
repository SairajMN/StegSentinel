# Primary Provider: Google Gemini (Google AI Studio key with credits)
# Free credits work with generous limits: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bedrock: works with AWS_BEARER_TOKEN_BEDROCK or BEDROCK_API_KEY.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL=
AWS_REGION=us-east-1

# Optional fallback providers:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Failover router (src/router.mjs), registered in TrueForge as the `failover` provider.
ROUTER_PORT=8788
ROUTER_MODEL=steg-primary

# Unattended sweep. TrueForge rejects anything tighter than hourly.
SWEEP_CRON=0 * * * *

# TrueForge harness
TRUEFORGE_BASE_URL=http://localhost:8790
DAYTONA_API_KEY=

# Skill source: the sandbox sparse-clones this path. Push before registering.
SKILL_REPO_URL=https://github.com/SairajMN/StegSentinel
SKILL_REPO_PATH=skills/steg-triage
SKILL_REPO_REF=main

# Local Gmail fetcher (the primary reader). Authorize once in a browser.
# --client-id-file is required: Google blocks gcloud's own OAuth client for gmail.readonly.
# gcloud also rejects gmail.readonly unless cloud-platform is in the list.
#   gcloud auth application-default login \
#     --client-id-file=$HOME/Downloads/client_secret_<your-project>.json \
#     --scopes=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/cloud-platform
# Use $HOME, not ~ — gcloud does not expand a tilde in a flag value.
# Optional overrides; the defaults match a recent inbox with attachments.
GMAIL_QUERY=has:attachment newer_than:7d
GMAIL_MAX_RESULTS=25
STAGE_DIR=data/staged

# Gmail MCP (optional second reader). Google's MCP server publishes no OAuth
# registration_endpoint, so TrueForge's auth.type=dcr cannot work with it. Supply a static
# credential instead — either an OAuth access token (GMAIL_MCP_TOKEN) or a Google API key
# (GMAIL_API_KEY). Token wins if both are set.
GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
GMAIL_MCP_TOKEN=
GMAIL_API_KEY=

# Slack MCP
SLACK_MCP_URL=
SLACK_MCP_TOKEN=
